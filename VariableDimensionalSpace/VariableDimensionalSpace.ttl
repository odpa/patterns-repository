###  https://w3id.org/hacid/onto/data/Variable
:Variable rdf:type owl:Class ;
          rdfs:subClassOf <https://w3id.org/hacid/onto/top-level/Concept> ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty <https://w3id.org/hacid/onto/top-level/hasPart> ;
                            owl:allValuesFrom :Variable
                          ] ;
          rdfs:comment "A variable is an abstraction that has meaning in the context of some relation between different variables and can be associated to different values in a set that is usually well defined. The set of possible values is represented by a data:DimensionalSpace; the two are linked via the data:hasValuesOn property."@en ;
          rdfs:isDefinedBy <https://w3id.org/hacid/onto/data> ;
          rdfs:label "Variable"@en .


###  https://w3id.org/hacid/onto/data/VariableSpecialization
:VariableSpecialization rdf:type owl:Class ;
                        rdfs:subClassOf <https://w3id.org/hacid/onto/top-level/Parameter> ;
                        rdfs:comment "The specialization of a dependent variable by choosing a specific region for the values of one or more of the inependent variables it depends on."@en ;
                        rdfs:isDefinedBy <https://w3id.org/hacid/onto/data> ;
                        rdfs:label "Variable Specialization"@en .


